# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by Git. Never commit real passwords.
DATABASE_URL=postgresql+asyncpg://nexus:CHANGE_ME@localhost:5432/nexus
APALEO_CLIENT_ID=your-apaleo-client-id
APALEO_CLIENT_SECRET=your-apaleo-client-secret
APALEO_PROPERTY_ID=your-property-code
APALEO_WEBHOOK_TOKEN=generate-a-random-string

# --- Rooms and doors (all optional) ---
# Rooms a new booking can be put in (the rooms the simulator runs):
ASSIGNABLE_ROOMS=room1,room2
# Hour of the day (hotel time) when door codes stop working on the departure day:
CHECKOUT_HOUR=12
# Time zone of the hotel (needs "pip install tzdata" on Windows):
HOTEL_TIMEZONE=Asia/Beirut
# TT Lock. Leave empty to use the simulated door. See docs for how to get these.
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_USERNAME=
TTLOCK_PASSWORD_MD5=
# Which TT Lock door belongs to which room: room1:1234567,room2:7654321
TTLOCK_LOCK_IDS=
# Set to sim to force the simulated door even when TT Lock is set up:
# TTLOCK_MODE=sim
# Energy report (estimates, in kW / price per kWh / kg CO2 per kWh):
AC_OCCUPIED_KW=1.2
AC_ECO_KW=0.3
ENERGY_PRICE_PER_KWH=0.20
ENERGY_CURRENCY=USD
GRID_KG_CO2_PER_KWH=0.5
